PORT=5000
NODE_ENV=production

MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=10d
JWT_REFRESH_EXPIRES_IN=20d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use "demo" until Paystack credentials are available; change to "paystack" for live/test provider calls.
PAYMENT_MODE=demo
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://your-app.vercel.app/payments/callback
# Leave at 0 until the client confirms the marketplace commission.
PLATFORM_FEE_PERCENT=0
# Use "platform" or "seller". Leave as platform until the client confirms.
PAYSTACK_FEE_BEARER=platform

MAIL_USER=
MAIL_PASS=

# Comma-separated if you need to allow more than one frontend origin
# (e.g. production domain + a Vercel preview URL).
CLIENT_URL=https://your-app.vercel.app

ADMIN_EMAIL=
ADMIN_PASSWORD=
